include README.md LICENSE NOTICE LICENSE_SCOPE.md UPSTREAM.md pyproject.toml
recursive-include LICENSES *.txt
recursive-include docs *.md
recursive-include examples *.py *.sh *.sbatch in.*
recursive-include ictc_o3/ascendc CMakeLists.txt *.cmake *.h *.cpp
recursive-include lammps_user_mfftorch *.md *.txt *.cmake *.h *.cpp *.sh *.in in.*
include lammps_user_mfftorch/install_ascend.py
include lammps_user_mfftorch/launch_ascend.py
prune benchmarks
prune validation
prune scripts
prune artifacts
prune docs/legacy
prune mace_ictc/bench
prune mace_ictc/test
prune .git
recursive-exclude * __pycache__ *.pyc *.pyo *.log *.csv *.xml *.json *.png *.pdf *.svg *.whl *.pt2 *.pth

recursive-include docs/figures *.svg *.png
