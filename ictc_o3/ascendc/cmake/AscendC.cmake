if(CMAKE_SOURCE_DIR STREQUAL CMAKE_BINARY_DIR)
    message(FATAL_ERROR "Use an out-of-source build: cmake -S <source> -B <build>")
endif()

if(NOT ASCEND_CANN_PACKAGE_PATH)
    foreach(variable ASCEND_CANN_PACKAGE_PATH ASCEND_HOME_PATH ASCEND_INSTALL_PATH)
        if(DEFINED ENV{${variable}} AND NOT "$ENV{${variable}}" STREQUAL "")
            set(ASCEND_CANN_PACKAGE_PATH "$ENV{${variable}}")
            break()
        endif()
    endforeach()
endif()
if(NOT ASCEND_CANN_PACKAGE_PATH)
    message(FATAL_ERROR "Source CANN set_env.sh or set ASCEND_CANN_PACKAGE_PATH")
endif()
get_filename_component(ASCEND_CANN_PACKAGE_PATH "${ASCEND_CANN_PACKAGE_PATH}" REALPATH)
set(ASCEND_CANN_PACKAGE_PATH "${ASCEND_CANN_PACKAGE_PATH}" CACHE PATH "CANN toolkit root" FORCE)
set(_ictc_asc_modules "${ASCEND_CANN_PACKAGE_PATH}/compiler/tikcpp/ascendc_kernel_cmake/asc_modules")
if(NOT EXISTS "${_ictc_asc_modules}/FindASC.cmake")
    message(FATAL_ERROR "CANN ASC CMake modules are missing from ${_ictc_asc_modules}; install the CANN compiler package")
endif()

set(SOC_VERSION "${SOC_VERSION}" CACHE STRING "Target SoC, for example Ascend910B3")
if(NOT SOC_VERSION MATCHES "^Ascend[A-Za-z0-9_]+$")
    message(FATAL_ERROR "Set SOC_VERSION to the target chip name, for example Ascend910B3")
endif()
# The official ASC module reads this variable in its compiler discovery code.
set(ENV{ASCEND_HOME_PATH} "${ASCEND_CANN_PACKAGE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${_ictc_asc_modules}")
set(ENABLE_ACLRT_LAUNCH OFF)
find_package(ASC REQUIRED MODULE)
